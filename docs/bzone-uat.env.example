# Copy to the git-ignored .env.uat.local before entering credentials.
# Load from the repository root: set -a; source .env.uat.local; set +a
# Then run: pnpm uat:bzone:strict
# The UAT harness must also be present (PR #117).
# No account or disposable target is created by this template.

KRUXT_UAT_PLATFORM_URL=https://kruxt-platform.vercel.app
KRUXT_UAT_ADMIN_URL=https://kruxt-admin.vercel.app
KRUXT_UAT_WEB_URL=https://kruxt-beta.vercel.app
KRUXT_UAT_MOBILE_ENV_FILE=

KRUXT_UAT_PLATFORM_EMAIL=
KRUXT_UAT_PLATFORM_PASSWORD=
KRUXT_UAT_PLATFORM_EXPECTED_ROLE=
KRUXT_UAT_OWNER_EMAIL=
KRUXT_UAT_OWNER_PASSWORD=
KRUXT_UAT_STAFF_EMAIL=
KRUXT_UAT_STAFF_PASSWORD=
KRUXT_UAT_MEMBER_EMAIL=
KRUXT_UAT_MEMBER_PASSWORD=

KRUXT_UAT_GYM_ID=
KRUXT_UAT_GYM_SLUG=
KRUXT_UAT_BULK_MEMBERSHIP_ID=
KRUXT_UAT_BULK_USER_ID=
KRUXT_UAT_BULK_MEMBER_MARKER=
KRUXT_UAT_BULK_EXPECTED_STATUS=
KRUXT_UAT_BULK_EXPECTED_ROLE=
KRUXT_UAT_ASSIGNED_MEMBERSHIP_ID=
KRUXT_UAT_ASSIGNED_MEMBER_USER_ID=
KRUXT_UAT_ASSIGNED_MEMBER_MARKER=
KRUXT_UAT_ASSIGNED_EXPECTED_STATUS=

# Enable only after verifying the exact disposable targets above.
KRUXT_UAT_ALLOW_MUTATIONS=0
KRUXT_UAT_PRODUCTION_CONFIRMATION=
